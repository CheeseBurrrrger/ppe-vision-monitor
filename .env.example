# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:80,http://localhost:5173

# Auth
JWT_SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Internal CV → Backend service key (must match in both backend and core)
CV_SERVICE_KEY=change-me-to-a-random-service-key

# Core inference model inside the Docker image
MODEL_PATH=/app/model/best_deva.pt

# Frontend (HTTPS only — 80/443 reserved for other services)
FRONTEND_HTTPS_PORT=8443

# CV output directory (mounted into backend and core)
CV_OUTPUT_DIR=./core/inference_output
